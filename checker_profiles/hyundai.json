       "op": "eq",
       "value": 0
      }
     ]
    }
   ],
   "fix": "Use case decides: enable THIS rule or RM12a, not both."
  },
  {
   "id": "RM13",
   "title": "CC \"Not exceeding N CC\" → CC UL ≈ N",
   "enabled": true,
   "severity": "ERROR",
   "when": [
    {
     "col": "CC",
     "op": "regex",
     "value": "Not exceeding (\\d+)\\s*CC"
    }
   ],
   "match": "all",
   "effects": {},
   "expect": [
    {
     "band": {},
     "conds": [
      {
       "col": "Cubic Capacity Ul*",
       "op": "between",
       "value": [
        "={1}-1",
        "={1}+1"
       ]
      }
     ]
    }
   ],
   "fix": "The preset does not map CC — set CC LL/UL by hand."
  },
  {
   "id": "RM14",
   "title": "CC \"Between A and B\" → CC LL ≈ A, UL ≈ B",
   "enabled": true,
   "severity": "ERROR",
   "when": [
    {
     "col": "CC",
     "op": "regex",
     "value": "Between (\\d+)\\s*CC and (\\d+)\\s*CC"
    }
   ],
   "match": "all",
   "effects": {},
   "expect": [
    {
     "band": {},
     "conds": [
      {
       "col": "Cubic Capacity Ll*",
       "op": "between",
       "value": [
        "={1}-1",
        "={1}+1"
       ]
      },
      {
       "col": "Cubic Capacity Ul*",
       "op": "between",
       "value": [
        "={2}-1",
        "={2}+1"
       ]
      }
     ]
    }
   ],
   "fix": ""
  },
